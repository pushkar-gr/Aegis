# Build Stage
FROM golang:1.27.3-alpine3.23 AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app
COPY go.mod ./
COPY go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o controller ./main.go

# Run Stage
FROM alpine:3.24.3
WORKDIR /app
RUN apk add --no-cache openssl ca-certificates
COPY --from=builder /app/controller .
COPY static ./static
CMD ["./controller"]
